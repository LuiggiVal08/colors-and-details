{
    "name": "my-expo-app",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "android": "expo start --android",
        "ios": "expo start --ios",
        "start": "expo start",
        "start:prod": "cross-env NODE_ENV=production expo start",
        "prebuild": "expo prebuild",
        "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
        "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
        "typecheck": "tsc --noEmit",
        "web": "expo start --web"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.0.2",
        "@gorhom/bottom-sheet": "^5.2.14",
        "@hookform/resolvers": "^5.2.2",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-community/datetimepicker": "9.2.1",
        "@react-native-picker/picker": "2.11.4",
        "@shopify/flash-list": "2.3.2",
        "@tanstack/react-query": "^5.96.1",
        "axios": "^1.14.0",
        "expo": "^58.0.5",
        "expo-constants": "~58.0.10",
        "expo-font": "~58.0.7",
        "expo-haptics": "~58.0.5",
        "expo-image-picker": "~58.0.10",
        "expo-linear-gradient": "~58.0.3",
        "expo-linking": "~58.0.11",
        "expo-local-authentication": "~58.0.2",
        "expo-router": "~58.0.15",
        "expo-secure-store": "~58.0.2",
        "expo-sharing": "~58.0.15",
        "expo-status-bar": "~58.0.3",
        "lodash.debounce": "^4.0.8",
        "nativewind": "latest",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.72.0",
        "react-native": "0.88.0-rc.3",
        "react-native-chart-kit": "^6.12.0",
        "react-native-gesture-handler": "~3.2.1",
        "react-native-gifted-charts": "^1.4.76",
        "react-native-keyboard-controller": "1.22.4",
        "react-native-paper": "^5.15.0",
        "react-native-reanimated": "4.7.0",
        "react-native-safe-area-context": "~5.9.1",
        "react-native-screens": "~4.28.0",
        "react-native-svg": "15.15.5",
        "react-native-worklets": "0.13.0",
        "socket.io-client": "^4.8.3",
        "zod": "^4.3.6",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@types/react": "~19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "cross-env": "^10.1.0",
        "dotenv": "^18.0.5",
        "eslint": "^9.25.1",
        "eslint-config-expo": "~58.0.4",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-react-native": "^5.0.0",
        "prettier": "^3.2.5",
        "prettier-plugin-tailwindcss": "^0.5.11",
        "tailwindcss": "^3.4.0",
        "typescript": "~6.0.3"
    },
    "main": "expo-router/entry",
